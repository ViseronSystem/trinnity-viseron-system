{
  "name": "trinnity-viseron-system",
  "version": "5.0.0",
  "description": "Multi Agent AI Operating System CORE v5.0",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node --max-old-space-size=8192 dist/src/index.js",
    "start:exe": ".build\\tvs-standalone\\tvs-viseron-win.exe",
    "dev": "nodemon --exec tsx --max-old-space-size=8192 src/index.ts",
    "build": "tsc && node -e \"const f=require('fs-extra');f.copySync('src/dashboard/public','dist/src/dashboard/public',{overwrite:true});console.log('[build] public/ copied')\"",
    "test": "tsx tests/core.test.ts && tsx tests/web.test.ts",
    "test:core": "tsx tests/core.test.ts",
    "test:web": "tsx tests/web.test.ts",
    "demo": "tsx scripts/demo-operacional.ts",
    "test:hyper": "tsx tests/hyperbrain.test.ts",
    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/build-all.ps1 -Target android",
    "build:ios": "powershell -ExecutionPolicy Bypass -File scripts/build-all.ps1 -Target ios",
    "build:all": "powershell -ExecutionPolicy Bypass -File scripts/build-all.ps1 -Target all",
    "build:eas-android": "powershell -ExecutionPolicy Bypass -File scripts/build-all.ps1 -Target eas-android",
    "build:eas-ios": "powershell -ExecutionPolicy Bypass -File scripts/build-all.ps1 -Target eas-ios",
    "mobile:start": "cd mobile && npx expo start",
    "mobile:android": "cd mobile && npx expo run:android",
    "mobile:ios": "cd mobile && npx expo run:ios",
    "launch": "tsx src/launch/market.ts",
    "setup": "npm install && cd mobile && npm install",
    "lint": "tsc --noEmit",
    "omniroute:install": "npm install omniroute",
    "omniroute:start": "node -e \"const{OmniRouteBridge}=require('./dist/src/integrations/omniroute/OmniRouteBridge');new OmniRouteBridge(null,{port:20128,autoStart:true}).initialize()\"",
    "build:exe": "node scripts/build-standalone.mjs",
    "build:exe:win": "node scripts/build-standalone.mjs --platform win",
    "build:exe:mac": "node scripts/build-standalone.mjs --platform mac",
    "build:exe:linux": "node scripts/build-standalone.mjs --platform linux",
    "build:exe:all": "node scripts/build-standalone.mjs --platform all",
    "build:electron": "node scripts/build-standalone.mjs --platform win --electron",
    "build:electron:all": "node scripts/build-standalone.mjs --platform all --electron",
    "electron:setup": "cd electron && npm install",
    "electron:start": "cd electron && npx electron .",
    "electron:build:win": "cd electron && npm run build:win",
    "electron:build:mac": "cd electron && npm run build:mac",
    "electron:build:linux": "cd electron && npm run build:linux",
    "call:start": "node -e \"require('./dist/src/integrations/call-system/CallSystemBridge').startServer()\"",
    "jarvis:start": "node -e \"require('./dist/src/integrations/openjarvis/OpenJarvisBridge').startServer()\"",
    "asno:start": "node -e \"require('./dist/src/integrations/asno/ASNOBridge').startServer()\"",
    "super:start": "tsx src/index.ts",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-system.ps1",
    "backup:schedule": "powershell -ExecutionPolicy Bypass -File scripts/schedule-backup.ps1",
    "skills": "tsx scripts/skills.ts",
    "skills:install": "tsx scripts/skills.ts install",
    "skills:list": "tsx scripts/skills.ts list",
    "skills:search": "tsx scripts/skills.ts search",
    "skills:info": "tsx scripts/skills.ts info",
    "init": "powershell -ExecutionPolicy Bypass -File scripts/init-system.ps1",
    "init:full": "powershell -ExecutionPolicy Bypass -File scripts/init-system.ps1 -Full",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-all.ps1",
    "deploy:all": "powershell -ExecutionPolicy Bypass -File scripts/deploy-all.ps1 -Full",
    "deploy:full": "powershell -ExecutionPolicy Bypass -File scripts/deploy-all.ps1 -Full",
    "deploy:github": "powershell -ExecutionPolicy Bypass -File scripts/deploy-all.ps1 -GitHub",
    "deploy:render": "powershell -ExecutionPolicy Bypass -File scripts/deploy-render.ps1",
    "deploy:hostalia": "powershell -ExecutionPolicy Bypass -File scripts/deploy-hostalia.ps1",
    "deploy:vercel": "powershell -ExecutionPolicy Bypass -File scripts/deploy-all.ps1 -Vercel",
    "start:web": "node dist/src/web/standalone-server.js",
    "dev:web": "tsx src/web/standalone-server.ts",
    "audit:full": "node scripts/full-audit.mjs",
    "pitch": "tsx scripts/gerar-pitch-investidores.ts",
    "pitch:startup": "tsx scripts/gerar-pitch-startup.ts",
    "pitch:v6": "tsx scripts/gerar-pitch-v6.ts",
    "roadmap": "tsx scripts/gerar-roadmap-milionario.ts",
    "docs:100": "tsx scripts/gerar-100-melhorias.ts",
    "report:update": "tsx scripts/gerar-relatorio-update.ts",
    "report:state": "tsx scripts/gerar-relatorio-estado.ts",
    "docs:revenue": "tsx scripts/gerar-pipeline-receita.ts",
    "audit:arkom": "tsx scripts/audit-arkom.ts",
    "demo:jarvis": "tsx scripts/demo-jarvis.ts",
    "gmail:setup": "tsx scripts/setup-gmail.ts",
    "demo:email": "tsx scripts/demo-email.ts",
    "demo:messaging": "tsx scripts/demo-messaging.ts",
    "pdfs:all": "powershell -ExecutionPolicy Bypass -File scripts/gerar-todos-pdfs.ps1",
    "cudacyclone": "tsx scripts/cudacyclone.ts",
    "deploy:domain": "powershell -ExecutionPolicy Bypass -File scripts/setup-dominio.ps1 -GenEnv",
    "deploy:domain:check": "powershell -ExecutionPolicy Bypass -File scripts/setup-dominio.ps1 -Validate",
    "update:auto": "powershell -ExecutionPolicy Bypass -File scripts/self-update.ps1"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.3",
    "axios": "^1.18.1",
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "ollama": "^0.6.3",
    "open-multi-agent": "^1.8.0",
    "openai": "^7.1.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "pkg": {
    "scripts": [
      "dist/src/**/*.js",
      "dist/tests/**/*.js"
    ],
    "assets": [
      "node_modules/**/*",
      "data/**/*",
      "config/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": ".build/tvs-standalone"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "nexe": "^5.0.0-beta.4",
    "nodemon": "^3.1.14",
    "pkg": "^5.8.1"
  }
}
