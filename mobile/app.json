{
  "expo": {
    "name": "Trinnity Viseron System",
    "slug": "trinnity-viseron",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trinnity.viseron",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "Usado para comandos de voz ao TVS"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a2e"
      },
      "package": "com.trinnity.viseron",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
        "android": {
          "compileSdkVersion": 34,
          "targetSdkVersion": 34,
          "buildToolsVersion": "34.0.0",
          "kotlinVersion": "1.7.20",
          "usesCleartextTraffic": true,
          "newArchEnabled": false
        },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "tvsServerUrl": "http://localhost:3000",
      "eas": {
        "projectId": "723e1dfe-9ccc-41a4-bca2-bd68f4ddcfa7"
      }
    },
    "owner": "viseronsystem"
  }
}
