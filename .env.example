# Viseron Web Server - Environment Variables
# Copy this to .env and fill in your API keys

PORT=3000
NODE_ENV=production
CONTENT_SCHEDULE_MINUTES=120

# AI Providers (at least one required for auto-content)
# Ollama is used by default if no API keys are set
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
# GEMINI_API_KEY=...
# XAI_API_KEY=...

# ── Email ─────────────────────────────────────────────────────
# Provider: dev (default) | smtp | resend | sendgrid | gmail
# EMAIL_PROVIDER=dev
# EMAIL_FROM=Trinnity Viseron System <no-reply@trinnityviseronsystem.io>
# TVS_PUBLIC_URL=https://www.trinnityviseronsystem.io

# SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...

# Resend (https://resend.com)
# RESEND_API_KEY=re_...

# SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG....

# Gmail API (agente de atendimento) — corre: npm run gmail:setup
# GMAIL_CLIENT_ID=...
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
# GMAIL_USER=...

# ── Domínio ───────────────────────────────────────────────────
# HOSTALIA_FTP_HOST=ftp.seusite.com.br
# HOSTALIA_FTP_USER=...
# HOSTALIA_FTP_PASS=...
# HOSTALIA_FTP_PATH=/web
