# Viseron Web Server - Environment Variables
# Copy this to .env and fill in your API keys

PORT=3000
NODE_ENV=production
CONTENT_SCHEDULE_MINUTES=120

# AI Providers (at least one required for auto-content)
# Ollama is used by default if no API keys are set
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
# GEMINI_API_KEY=...
# XAI_API_KEY=...
