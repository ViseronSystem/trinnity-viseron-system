      "responsibilities": ["system_design", "documentation", "adr_generation", "component_modeling"],
      "capabilities": ["system_design", "api_design", "documentation", "architecture_decision_records"],
      "skills": ["api-design", "architecture-decision-records", "codebase-design", "domain-modeling", "improve-codebase-architecture"],
      "permissions": ["tools.execute.prompt", "memory.read", "memory.write", "skills.read"],
      "tools": ["architecture_review", "dependency_graph", "documentation_generator"],
      "verification": ["design_completeness", "adr_quality", "component_coupling_score"]
    }
  ],
  "workflows": {
    "engineering_improvement": {
      "name": "Engineering Improvement Workflow",
      "steps": [
        { "phase": "analysis", "agent": "agent_cto", "description": "Analyze codebase for improvement opportunities" },
        { "phase": "architecture_review", "agent": "agent_architect", "description": "Review architectural implications of changes" },
        { "phase": "security_review", "agent": "agent_security", "description": "Security audit of proposed changes" },
        { "phase": "implementation_plan", "agent": "agent_developer", "description": "Create implementation plan with rollback" },
        { "phase": "execution", "agent": "agent_developer", "description": "Implement the approved change" },
        { "phase": "test", "agent": "agent_qa", "description": "Run tests and verify no regressions" },
        { "phase": "evidence_check", "agent": "agent_qa", "description": "Collect execution evidence" },
        { "phase": "report", "agent": "agent_architect", "description": "Generate engineering report" }
      ]
    },
    "code_review": {
      "name": "Code Review Workflow",
      "steps": [
        { "phase": "standards_check", "agent": "agent_developer", "description": "Check code standards compliance" },
        { "phase": "spec_check", "agent": "agent_qa", "description": "Verify implementation matches specification" },
        { "phase": "security_check", "agent": "agent_security", "description": "Security vulnerability scan" },
        { "phase": "architecture_check", "agent": "agent_architect", "description": "Architecture consistency review" }
      ]
    }
  },
  "objectives": [
    { "id": "obj_01", "metric": "code_quality_score", "target": "> 80/100", "frequency": "per_review" },
    { "id": "obj_02", "metric": "test_coverage", "target": "> 80% for changed files", "frequency": "per_change" },
    { "id": "obj_03", "metric": "vulnerability_detection_rate", "target": "> 90%", "frequency": "per_scan" },
    { "id": "obj_04", "metric": "architecture_compliance", "target": "no regressions", "frequency": "per_change" }
  ],
  "memory": {
    "stm": true,
    "ltm": true,
    "shared_knowledge": ["engineering_patterns", "architecture_decisions", "security_baselines"],
    "isolated_per_project": true
  }
}
