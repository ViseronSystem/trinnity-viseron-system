  "workflows": [
    { "id": "wf_pipeline", "name": "Sales Pipeline", "steps": ["prospect", "qualify", "propose", "close"] },
    { "id": "wf_finance", "name": "Finance Review", "steps": ["collect", "analyze", "report"] }
  ],
  "memory": { "stm": true, "ltm": true, "sharedGraph": true, "vector": false },
  "permissions": [
    { "resource": "crm", "actions": ["read", "write"] },
    { "resource": "billing", "actions": ["read"] }
